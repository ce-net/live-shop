{
  "name": "live-shop-web",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "shop.web: the store page, compiled against the generated shop.gateway client in ../sdk/ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && esbuild src/app.ts --bundle --format=esm --target=es2020 --minify --legal-comments=none --outfile=dist/app.js"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
